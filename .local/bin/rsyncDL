#!/bin/sh

# This script uses rsync to download specified files from a remote computer running an SSH server.

programName=rsyncDL

helpMsg(){
    cat << END
Usage:
$programName -l [OPTION]... IP PORT PRIVATE_KEY SOURCE DEST
$programName -s [OPTION]... IP PORT PRIVATE_KEY SOURCE DEST

Use rsync to download (-l) or upload (-s) files from a remote computer running an SSH server.

IP is the IP address of the remote machine.
PORT is the port number of the remote machine to connect with.
PRIVATE_KEY is the path of the private key file to authenticate with.
SOURCE is the path to copy from.
DEST is the path to put SOURCE to (e.g., the local user's home directory if pulling from remote).

Modes
  -l, --pull                download from a remote machine
  -s, --push                upload to a remote machine

OPTIONS
  -n, --dry-run             make no changes (trial run)
  -r, --recursive           recurse into directories
  -a, --archive             archive mode is -rlptgoD
  -h, --help                display this help text and exits the script
END
}

[ $# = 0 ] && printf "Usage: %s {-l | -s} [OPTION]... IP PORT PRIVATE_KEY SOURCE DEST\nTry '%s --help' for more information.\n" $programName $programName >&2 && exit 1

echo "$1" | grep -E "^-\w?n\w?" && doDryrun=n
echo "$1" | grep -E "^-\w?r\w?" && doRecursive=r
echo "$1" | grep -E "^-\w?a\w?" && doArchive=a

case $1 in
    -h | --help) helpMsg ; exit 0;;
    -*l* | --pull)
        targetIP=$2; portNum=$3; privKey=$4; source=$5; destination=$6
        rsync -vP${doDryrun}${doRecursive}${doArchive}e "ssh -p $portNum -i $privKey" "$targetIP":"$source" "$destination"
        ;;
    -*s* | --push)
        targetIP=$2; portNum=$3; privKey=$4; source=$5; destination=$6
        rsync -vP${doDryrun}${doRecursive}${doArchive}e "ssh -p $portNum -i $privKey" "$source" "$targetIP":"$destination"
        ;;
esac
